{
  "name": "model-flow",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web":    "nuxt dev",
    "build:web":  "nuxt build",
    "preview:web":"nuxt preview",
    "generate":   "nuxt generate",
    "postinstall":"nuxt prepare",
    "dev:api":    "npm run dev --workspace=@model-flow/api",
    "dev:worker": "npm run dev --workspace=@model-flow/worker",
    "dev":        "npm-run-all --parallel dev:web dev:api dev:worker",
    "build:api":  "npm run build --workspace=@model-flow/api",
    "test:api":   "npm run test --workspace=@model-flow/api",
    "test:worker":"npm run test --workspace=@model-flow/worker"
  },
  "dependencies": {
    "@pinia/nuxt": "^0.9.0",
    "nuxt": "^4.5.2",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.13.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17"
  }
}